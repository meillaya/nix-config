production-scan-scope=hosts,modules,bin,docs,flake.nix,overlays
production_plain_or_inline_password_options=0
production_modular_password_hashes=0
production_private_key_markers=0
production-manifest-complete=PASS
plaintext-detection=PASS
multiline-initial-detection=PASS
sha512-detection=PASS
bcrypt-detection=PASS
phc-scrypt-detection=PASS
private-key-detection=PASS
age-key-detection=PASS
external-file-and-regex-negative-control=PASS
unreadable-file-fails-closed=PASS
search-process-error-fails-closed=PASS
git-file-list-error-fails-closed=PASS
hash-search-error-fails-closed=PASS
private-key-search-error-fails-closed=PASS
cleanup=/tmp/nix-bootstrap-secret-scan.lPcdZm
