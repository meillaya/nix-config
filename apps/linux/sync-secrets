#!/usr/bin/env bash
set -euo pipefail

umask 077
shopt -s dotglob nullglob

repo=${NIX_SECRETS_REPO:-}
repo_root=${NIX_CONFIG_REPO_ROOT:-}
workdir=
stage_dir=
initial_destination_identity=
staged_payload_identity=
exchange_attempted=0

usage() {
  cat <<'EOF'
Usage: sync-secrets [--repo GIT_URL] [--repo-root WRITABLE_CHECKOUT]

The destination must be the root of a writable Git checkout. Resolution order:
  1. --repo-root
  2. NIX_CONFIG_REPO_ROOT

Examples:
  NIX_SECRETS_REPO=git@github.com:Meillaya/nix-screts.git \
    nix run .#sync-secrets -- --repo-root "$PWD"
  NIX_CONFIG_REPO_ROOT="$PWD" \
    nix run .#sync-secrets -- --repo git@github.com:Meillaya/nix-screts.git
EOF
}

fail() {
  printf >&2 'sync-secrets: %s\n' "$1"
  exit "${2:-2}"
}

path_exists() {
  [[ -e $1 || -L $1 ]]
}

cleanup() {
  local status=$?
  local live_identity='' stage_identity='' preserve_stage=0
  trap - EXIT HUP INT TERM

  if ((exchange_attempted)) && [[ -n $stage_dir ]]; then
    live_identity=$(stat -Lc '%d:%i' -- secrets 2>/dev/null) || live_identity=
    stage_identity=$(stat -Lc '%d:%i' -- "$stage_dir" 2>/dev/null) || stage_identity=

    if [[ -n $staged_payload_identity && $live_identity == "$staged_payload_identity" ]] \
      || [[ -n $initial_destination_identity && $stage_identity == "$initial_destination_identity" ]]; then
      if mv -T --exchange -- "$stage_dir" secrets; then
        exchange_attempted=0
        live_identity=$(stat -Lc '%d:%i' -- secrets 2>/dev/null) || live_identity=
        stage_identity=$(stat -Lc '%d:%i' -- "$stage_dir" 2>/dev/null) || stage_identity=
        if [[ $live_identity != "$initial_destination_identity" \
          || $stage_identity != "$staged_payload_identity" ]]; then
          printf >&2 '%s\n' \
            'sync-secrets: atomic rollback completed but tree revalidation failed'
          status=1
          preserve_stage=1
        fi
      else
        printf >&2 '%s\n' \
          'sync-secrets: atomic rollback failed; preserved both live and displaced trees'
        status=1
        preserve_stage=1
      fi
    elif [[ $live_identity != "$initial_destination_identity" \
      || $stage_identity != "$staged_payload_identity" ]]; then
      printf >&2 '%s\n' \
        'sync-secrets: exchange outcome is indeterminate; preserved both trees for recovery'
      status=1
      preserve_stage=1
    fi
  fi

  if [[ -n $stage_dir ]] && path_exists "$stage_dir" && ((preserve_stage == 0)); then
    if ! rm -rf -- "$stage_dir"; then
      printf >&2 'sync-secrets: failed to remove temporary secrets tree: %s\n' "$stage_dir"
      status=1
    fi
  fi
  if [[ -n $workdir ]]; then
    if ! rm -rf -- "$workdir"; then
      printf >&2 'sync-secrets: failed to remove private clone directory: %s\n' "$workdir"
      status=1
    fi
  fi

  exit "$status"
}
trap cleanup EXIT

interrupted() {
  local signal=$1
  local status=$2
  printf >&2 'sync-secrets: interrupted by %s; restoring the prior live tree if exchanged\n' "$signal"
  exit "$status"
}
trap 'interrupted HUP 129' HUP
trap 'interrupted INT 130' INT
trap 'interrupted TERM 143' TERM

reject_symlinks_under() {
  local root=$1
  local label=$2
  local current entry
  local -a pending entries

  if [[ -L $root ]]; then
    fail "$label must not contain symlinks"
  fi
  if [[ ! -d $root ]]; then
    fail "$label must be a real directory"
  fi

  pending=("$root")
  while ((${#pending[@]})); do
    current=${pending[-1]}
    unset 'pending[-1]'

    if [[ -L $current ]]; then
      fail "$label must not contain symlinks"
    fi
    if [[ ! -d $current || ! -r $current || ! -x $current ]]; then
      fail "$label could not be inspected safely"
    fi

    entries=("$current"/*)
    for entry in "${entries[@]}"; do
      if [[ -L $entry ]]; then
        fail "$label must not contain symlinks"
      fi
      if [[ -d $entry ]]; then
        pending+=("$entry")
      fi
    done
  done
}

while [[ $# -gt 0 ]]; do
  case $1 in
    --repo)
      [[ $# -ge 2 && -n $2 ]] || fail '--repo requires a value'
      repo=$2
      shift 2
      ;;
    --repo-root)
      [[ $# -ge 2 && -n $2 ]] || fail '--repo-root requires a value'
      repo_root=$2
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      fail 'unknown argument; use --help for accepted options'
      ;;
  esac
done

[[ -n $repo ]] || fail 'set NIX_SECRETS_REPO or pass --repo'
[[ -n $repo_root ]] || fail 'pass --repo-root or NIX_CONFIG_REPO_ROOT from a writable checkout'

case $repo_root in
  /nix/store|/nix/store/*)
    fail 'refusing to write plaintext material into the Nix store'
    ;;
esac

[[ -d $repo_root ]] || fail 'checkout does not exist'
repo_root=$(cd -P -- "$repo_root" && pwd) || fail 'checkout could not be resolved safely'

case $repo_root in
  /nix/store|/nix/store/*)
    fail 'refusing a checkout that resolves into the Nix store'
    ;;
esac

if ! git_root=$(git -C "$repo_root" rev-parse --show-toplevel 2>/dev/null); then
  fail 'destination is not a Git checkout'
fi
git_root=$(cd -P -- "$git_root" && pwd) || fail 'Git checkout root could not be resolved safely'
[[ $git_root == "$repo_root" ]] || fail 'destination must be the checkout root'
[[ -f $repo_root/flake.nix ]] || fail 'checkout has no flake.nix'
[[ -w $repo_root && -x $repo_root ]] || fail 'checkout is not writable'

# Pin subsequent destination operations to this directory rather than repeatedly
# resolving an attacker-replaceable absolute checkout path.
cd -- "$repo_root"
repo_root=$PWD

if [[ -L secrets || ( -e secrets && ! -d secrets ) ]]; then
  fail 'secrets destination must be a real directory inside the checkout'
fi
if [[ ! -e secrets ]]; then
  mkdir -m 0700 -- secrets || fail 'checkout is not writable'
fi
[[ -d secrets && ! -L secrets ]] || fail 'secrets destination must be a real directory inside the checkout'

reject_symlinks_under secrets 'destination secrets tree'
initial_destination_identity=$(stat -Lc '%d:%i' -- secrets) \
  || fail 'destination secrets tree could not be inspected safely'

if ! stage_dir=$(mktemp -d .sync-secrets.new.XXXXXX); then
  fail 'checkout is not writable'
fi
chmod 0700 -- "$stage_dir"

workdir=$(mktemp -d) || fail 'could not create a private temporary directory'
if ! GIT_TERMINAL_PROMPT=0 git clone --depth=1 -- "$repo" "$workdir/repo" >/dev/null 2>&1; then
  fail 'failed to clone configured secrets repository' 1
fi

reject_symlinks_under "$workdir/repo" 'cloned source payload'

if ! rsync -a --delete \
  --exclude='.git' \
  --exclude='README.md' \
  -- "$workdir/repo/" "$stage_dir/"; then
  fail 'failed to stage secrets payload' 1
fi

reject_symlinks_under "$stage_dir" 'staged secrets payload'
chmod 0700 -- "$stage_dir" \
  || fail 'staged secrets payload permissions could not be restricted' 1
staged_payload_identity=$(stat -Lc '%d:%i' -- "$stage_dir") \
  || fail 'staged secrets payload could not be inspected safely'

# Revalidate the live destination after rsync. Rsync only touches the private
# staging tree, so a concurrent destination replacement cannot redirect writes.
reject_symlinks_under secrets 'destination secrets tree'
current_destination_identity=$(stat -Lc '%d:%i' -- secrets) \
  || fail 'destination secrets tree could not be inspected safely'
[[ $current_destination_identity == "$initial_destination_identity" ]] \
  || fail 'destination secrets tree changed during synchronization'

checkout_device=$(stat -Lc '%d' -- .) \
  || fail 'checkout filesystem could not be inspected safely'
live_device=$(stat -Lc '%d' -- secrets) \
  || fail 'destination secrets tree could not be inspected safely'
stage_device=$(stat -Lc '%d' -- "$stage_dir") \
  || fail 'staged secrets payload could not be inspected safely'
[[ $live_device == "$checkout_device" && $stage_device == "$checkout_device" ]] \
  || fail 'staged and live secrets trees must share the checkout filesystem'

# GNU mv maps --exchange to renameat2(RENAME_EXCHANGE), so there is no point at
# which the checkout lacks a live secrets directory. Mark the attempt first: an
# interrupt can arrive after the kernel exchange but before mv returns, and the
# EXIT handler uses the recorded identities to detect and roll that state back.
exchange_attempted=1
if ! mv -T --exchange -- "$stage_dir" secrets; then
  fail 'could not atomically exchange staged and live secrets trees' 1
fi
# The new payload is live and the prior payload is now at the former stage path.
# Revalidate both sides, including identities, before committing the exchange.
reject_symlinks_under secrets 'installed secrets payload'
installed_identity=$(stat -Lc '%d:%i' -- secrets) \
  || fail 'installed secrets payload could not be inspected safely'
[[ $installed_identity == "$staged_payload_identity" ]] \
  || fail 'installed secrets payload changed during atomic exchange'
[[ $(stat -Lc '%a' -- secrets) == 700 ]] \
  || fail 'installed secrets payload permissions are not 0700'

reject_symlinks_under "$stage_dir" 'displaced secrets tree'
displaced_identity=$(stat -Lc '%d:%i' -- "$stage_dir") \
  || fail 'displaced secrets tree could not be inspected safely'
[[ $displaced_identity == "$initial_destination_identity" ]] \
  || fail 'destination secrets tree changed during atomic exchange'

exchange_attempted=0
old_live_tree=$stage_dir
stage_dir=
if ! rm -rf -- "$old_live_tree"; then
  fail 'secrets installed but displaced tree cleanup failed' 1
fi

printf 'Secrets synced outside Nix evaluation into %s/secrets\n' "$repo_root"
